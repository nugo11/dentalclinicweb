{
  "rewrites": [
    {
      "source": "/api/ubill/:path*",
      "destination": "https://api.ubill.dev/:path*"
    },
    {
      "source": "/api/ehr/:path*",
      "destination": "https://ehrsvc.moh.gov.ge/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
