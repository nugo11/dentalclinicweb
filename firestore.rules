rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. დამხმარე უსაფრთხოების ფუნქციები
    function isAuthenticated() {
      return request.auth != null;
    }

    // პლატფორმის სუპერ ადმინისტრატორები - მკაცრი შემოწმება ელ-ფოსტით
    function isSuperAdmin() {
      return isAuthenticated() && 
        request.auth.token.email != null && 
        (
          request.auth.token.email.lower() == 'nugoxucishvili@gmail.com' ||
          request.auth.token.email.lower() == 'khvedelidzezura77@gmail.com'
        );
    }

    function getUserClinicId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId : null;
    }

    function belongsToUserClinic(clinicId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (clinicId != null && (
          request.auth.uid == clinicId || 
          getUserClinicId() == clinicId
        ))
      );
    }

    // 2. კლინიკები (Clinics)
    // წაკითხვა დაშვებულია ყველასთვის (საჭიროა ლოგინისთვის loginName-ით, რეგისტრაციისას უნიკალურობის შემოწმებისთვის და საჯარო კატალოგისთვის)
    // შექმნა შეუძლია ნებისმიერ ავტორიზებულ პირს (რეგისტრაციის დროს)
    // რედაქტირება და წაშლა შეუძლია კლინიკის ადმინს ან სუპერ ადმინს
    match /clinics/{clinicId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid == clinicId
      );
    }

    // 3. მომხმარებლები და პერსონალი (Users / Staff)
    // წაკითხვა დაშვებულია (საჭიროა რეგისტრაციისას ტელეფონის/მეილის შემოწმებისთვის, ლოგინისას პერსონალის სიისთვის და საჯარო პროფილზე ექიმებისთვის)
    // რედაქტირება/წაშლა შეზღუდულია საკუთარ კლინიკაზე ან სუპერ ადმინზე
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == userId ||
        belongsToUserClinic(resource.data.clinicId)
      );
    }

    // 4. სუპერ ადმინის აუდიტის ჟურნალი (SuperAdmin Audit Log)
    // წაკითხვა და შექმნა შეუძლია მხოლოდ სუპერ ადმინისტრატორს. შეცვლა ან წაშლა დაუშვებელია!
    match /admin_audit_logs/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // 5. პაციენტები (Patients) - მკაცრი Multi-Tenant იზოლაცია
    match /patients/{patientId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 6. ვიზიტები და ჯავშნები (Appointments / Calendar)
    match /appointments/{appointmentId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 7. პაციენტის რენტგენები (Patient X-Rays)
    match /patient_xrays/{xrayId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 8. საწყობი და მარაგი (Inventory)
    match /inventory/{itemId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 9. მომსახურებები და ტარიფები (Services)
    // წაკითხვა დაშვებულია საჯარო პროფილისთვისაც, მართვა მხოლოდ საკუთარი კლინიკისთვის
    match /services/{serviceId} {
      allow read: if true;
      allow delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 10. ფინანსები და ხელფასები (Finance) - მკაცრი Multi-Tenant იზოლაცია
    match /finance/{financeId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 11. აქტივობების ლოგი (Audit Log) - ჩანაწერის შეცვლა/წაშლა დაუშვებელია
    match /activity/{activityId} {
      allow read: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update, delete: if isSuperAdmin();
    }

    // 12. სხვა ნებისმიერი დამხმარე კოლექცია
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
