rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. დამხმარე უსაფრთხოების ფუნქციები
    function isAuthenticated() {
      return request.auth != null;
    }

    // პლატფორმის სუპერ ადმინისტრატორები - მკაცრი შემოწმება ელ-ფოსტით
    function isSuperAdmin() {
      return isAuthenticated() && 
        request.auth.token.email != null && 
        (
          request.auth.token.email.lower() == 'nugoxucishvili@gmail.com' ||
          request.auth.token.email.lower() == 'khvedelidzezura77@gmail.com'
        );
    }

    // 2. კლინიკები (Clinics)
    // წაკითხვა დაშვებულია ყველასთვის (საჭიროა ლოგინისთვის loginName-ით, რეგისტრაციისას უნიკალურობის შემოწმებისთვის და საჯარო კატალოგისთვის)
    // შექმნა შეუძლია ნებისმიერ ავტორიზებულ პირს (რეგისტრაციის დროს)
    // რედაქტირება და წაშლა შეუძლია კლინიკის ადმინს ან სუპერ ადმინს
    match /clinics/{clinicId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid == clinicId
      );
    }

    // 3. მომხმარებლები და პერსონალი (Users / Staff)
    // წაკითხვა დაშვებულია (საჭიროა რეგისტრაციისას ტელეფონის/მეილის შემოწმებისთვის, ლოგინისას პერსონალის სიისთვის და საჯარო პროფილზე ექიმებისთვის)
    // შექმნა, რედაქტირება და წაშლა ავტორიზებული მომხმარებლის მიერ (პერსონალის მართვა, PIN-ის მცდელობების განახლება და ა.შ.)
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 4. სუპერ ადმინის აუდიტის ჟურნალი (SuperAdmin Audit Log)
    // წაკითხვა და შექმნა შეუძლია მხოლოდ სუპერ ადმინისტრატორს. შეცვლა ან წაშლა დაუშვებელია!
    match /admin_audit_logs/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // 5. პაციენტები (Patients)
    match /patients/{patientId} {
      allow read, write: if isAuthenticated();
    }

    // 6. ვიზიტები და ჯავშნები (Appointments / Calendar)
    match /appointments/{appointmentId} {
      allow read, write: if isAuthenticated();
    }

    // 7. პაციენტის რენტგენები (Patient X-Rays)
    match /patient_xrays/{xrayId} {
      allow read, write: if isAuthenticated();
    }

    // 8. საწყობი და მარაგი (Inventory)
    match /inventory/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // 9. მომსახურებები და ტარიფები (Services)
    // წაკითხვა დაშვებულია საჯარო პროფილისთვისაც, მართვა ავტორიზებულთათვის
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 10. ფინანსები და ხელფასები (Finance)
    match /finance/{financeId} {
      allow read, write: if isAuthenticated();
    }

    // 11. აქტივობების ლოგი (Audit Log) - ჩანაწერის წაშლა/შეცვლა დაუშვებელია (მხოლოდ სუპერ ადმინს)
    match /activity/{activityId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // 12. სხვა ნებისმიერი დამხმარე კოლექცია
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
