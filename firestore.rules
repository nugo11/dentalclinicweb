rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. დამხმარე უსაფრთხოების ფუნქციები
    function isAuthenticated() {
      return request.auth != null;
    }

    // პლატფორმის სუპერ ადმინისტრატორები - მკაცრი შემოწმება ელ-ფოსტით
    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        (
          request.auth.token.email.lower() == 'nugoxucishvili@gmail.com' ||
          request.auth.token.email.lower() == 'khvedelidzezura77@gmail.com'
        );
    }

    function getUserClinicId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId : null;
    }

    function belongsToUserClinic(clinicId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (clinicId != null && (
          request.auth.uid == clinicId ||
          getUserClinicId() == clinicId
        ))
      );
    }

    // 2. კლინიკები (Clinics)
    // საჯარო კითხვა დაშვებულია ლოგინისა და კატალოგისთვის (სენსიტიური EHR ველები შენახულია /private ქვეკოლექციაში)
    match /clinics/{clinicId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        (isSuperAdmin() || request.resource.data.plan == 'free');
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (resource.data.ownerId == request.auth.uid || request.auth.uid == clinicId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'subscriptionStatus', 'customMaxDoctors', 'ownerId'])
        )
      );
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid == clinicId
        )
      );

      // კლინიკის კონფიდენციალური პარამეტრები (მაგ. EHR მომხმარებელი/პაროლი)
      match /private/{docId} {
        allow read, write: if belongsToUserClinic(clinicId);
      }
    }

    // 3. მომხმარებლები და პერსონალი (Users / Staff) - დახურულია არაავტორიზებული და უცხო კლინიკის კითხვისგან
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == userId ||
        belongsToUserClinic(resource.data.clinicId)
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == userId ||
        belongsToUserClinic(request.resource.data.clinicId)
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == userId ||
        belongsToUserClinic(resource.data.clinicId)
      );
    }

    // 4. სუპერ ადმინის აუდიტის ჟურნალი (SuperAdmin Audit Log)
    match /admin_audit_logs/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // 5. პაციენტები (Patients) - მკაცრი Multi-Tenant იზოლაცია
    match /patients/{patientId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 6. ვიზიტები და ჯავშნები (Appointments / Calendar) - მკაცრი Multi-Tenant იზოლაცია
    match /appointments/{appointmentId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 7. პაციენტის რენტგენები (Patient X-Rays)
    match /patient_xrays/{xrayId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 8. საწყობი და მარაგი (Inventory)
    match /inventory/{itemId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(request.resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 9. მომსახურებები და ტარიფები (Services)
    match /services/{serviceId} {
      allow read: if true;
      allow delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(request.resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 10. ფინანსები და ხელფასები (Finance) - მკაცრი Multi-Tenant იზოლაცია
    match /finance/{financeId} {
      allow read, delete: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update: if belongsToUserClinic(request.resource.data.clinicId) &&
                       (request.resource.data.clinicId == null || belongsToUserClinic(request.resource.data.clinicId));
    }

    // 11. აქტივობების ლოგი (Audit Log)
    match /activity/{activityId} {
      allow read: if belongsToUserClinic(resource.data.clinicId);
      allow create: if belongsToUserClinic(request.resource.data.clinicId);
      allow update, delete: if isSuperAdmin();
    }

    // 12. საკონტაქტო გვერდის შეტყობინებები
    match /contact_messages/{msgId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'email', 'message', 'createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 3000;
      allow read, update, delete: if isSuperAdmin();
    }

    // 13. სხვა ნებისმიერი დამხმარე კოლექცია
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
